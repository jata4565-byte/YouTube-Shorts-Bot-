# Groq API (Free AI content generation)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# YouTube API
# Download client_secrets.json from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Facebook API
# Get from: https://developers.facebook.com/docs/facebook-login/access-tokens/
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Upload Schedule (cron format)
# Examples: "0 9 * * *" = Every day at 9 AM
# "0 */6 * * *" = Every 6 hours
UPLOAD_SCHEDULE=0 9 * * *

# Number of videos to generate per day
VIDEOS_PER_DAY=1

# Enable/Disable uploads
ENABLE_YOUTUBE=true
ENABLE_FACEBOOK=true